# Copie para .env e preencha
GEMINI_API_KEY=
# Música REAL com vocais estilo Suno (Replicate, pago por uso):
# 1. Crie conta em https://replicate.com e pegue o token em Account > API tokens
# 2. Preencha abaixo. Modelo padrão gera músicas completas cantadas.
REPLICATE_API_TOKEN=
REPLICATE_MUSIC_MODEL=minimax/music-01
# Vocais reais GRATUITOS via ACE-Step (GPU gratuita no Colab/Kaggle):
# 1. Abra colab-voz-ia.ipynb no Google Colab (GPU grátis) e rode as células
# 2. Cole a URL pública (ngrok) ou local aqui:
# Token grátis do Hugging Face (opcional, aumenta a cota de vocais grátis):
# Crie conta em https://huggingface.co/join → Settings → Access Tokens
HF_TOKEN=
# Desative a demo pública gratuita (vocais) se quiser só motor local:
# HF_SPACE_DISABLED=1
PORT=3000
NODE_ENV=development
